FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ./shared/shared.csproj ./shared/
COPY ./frontend/frontend.csproj ./frontend/
RUN dotnet restore ./frontend/frontend.csproj

COPY ./shared/ ./shared/
COPY ./frontend/ ./frontend/
# NOTE: do not pass --no-restore here. Publishing with its own restore is what
# generates the Blazor static web assets (wwwroot/_framework/blazor.web.js);
# a prior `dotnet restore` + `--no-restore` publish omits them.
RUN dotnet publish ./frontend/frontend.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
EXPOSE 80
ENV ASPNETCORE_URLS=http://+:80

WORKDIR /app
COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "frontend.dll"]
